<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical"
    tools:context=".AnalyticsFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/analyticsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Top Header Bar: [<] Back Button, Title "Analytics", [Export] Button -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerBarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Rounded square back button -->
                <ImageView
                    android:id="@+id/buttonBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_analytics_back_button"
                    android:clickable="true"
                    android:contentDescription="Go back"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_back_chevron"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/text_primary" />

                <!-- Centered screen title -->
                <TextView
                    android:id="@+id/textScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Analytics"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Export Pill Button on Top Right -->
                <TextView
                    android:id="@+id/buttonExport"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_analytics_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="80dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Export"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Hidden download icon kept for ID compatibility -->
                <ImageView
                    android:id="@+id/buttonDownloadReport"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="Export"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Timeframe Filter Dropdown Card: [Calendar] Last 30 days [v] -->
            <LinearLayout
                android:id="@+id/buttonTimeframeSelector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_analytics_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Calendar"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/textSelectedTimeframe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Last 30 days"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Dropdown"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#64748B" />
            </LinearLayout>

            <!-- Card 1: REPORTS BY CATEGORY -->
            <LinearLayout
                android:id="@+id/cardReportsByCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_analytics_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/headingCategoryReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="REPORTS BY CATEGORY"
                    android:textColor="#8A9BA8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Donut Chart & Legend Row -->
                <LinearLayout
                    android:id="@+id/categoryChartRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Donut Chart -->
                    <com.group3.lostandfound.PieChartView
                        android:id="@+id/pieChartView"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:contentDescription="Category distribution donut chart" />

                    <!-- Legend Items -->
                    <LinearLayout
                        android:id="@+id/chartLegendContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Electronics 38% (#002B3D Dark Navy) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_circle_black"
                                android:backgroundTint="#002B3D" />

                            <TextView
                                android:id="@+id/tvCategoryElectronics"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Electronics 38%"
                                android:textColor="#475569"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Documents 27% (#2A9D8F Teal) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_circle_black"
                                android:backgroundTint="#2A9D8F" />

                            <TextView
                                android:id="@+id/tvCategoryDocuments"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Documents 27%"
                                android:textColor="#475569"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Pets 18% (#C1121F Red) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_circle_black"
                                android:backgroundTint="#C1121F" />

                            <TextView
                                android:id="@+id/tvCategoryPets"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Pets 18%"
                                android:textColor="#475569"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Other 17% (#94A3B8 Slate) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_circle_black"
                                android:backgroundTint="#94A3B8" />

                            <TextView
                                android:id="@+id/tvCategoryOther"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Other 17%"
                                android:textColor="#475569"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: RESOLUTION RATE -->
            <LinearLayout
                android:id="@+id/cardResolutionRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_analytics_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/headingResolutionRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="RESOLUTION RATE"
                    android:textColor="#8A9BA8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Colombo (92%) -->
                <LinearLayout
                    android:id="@+id/progressRowColombo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Colombo"
                            android:textColor="#475569"
                            android:textSize="13sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvPercentColombo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="92%"
                            android:textColor="#2A9D8F"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Rounded progress bar: teal fill on light grey track -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_progress_track_light"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/barColomboFill"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.92"
                            android:background="@drawable/bg_progress_fill_teal" />

                        <View
                            android:id="@+id/barColomboEmpty"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.08" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Kandy (84%) -->
                <LinearLayout
                    android:id="@+id/progressRowKandy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Kandy"
                            android:textColor="#475569"
                            android:textSize="13sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvPercentKandy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="84%"
                            android:textColor="#2A9D8F"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_progress_track_light"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/barKandyFill"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.84"
                            android:background="@drawable/bg_progress_fill_teal" />

                        <View
                            android:id="@+id/barKandyEmpty"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.16" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Galle (78%) -->
                <LinearLayout
                    android:id="@+id/progressRowGalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Galle"
                            android:textColor="#475569"
                            android:textSize="13sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvPercentGalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="78%"
                            android:textColor="#2A9D8F"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_progress_track_light"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/barGalleFill"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.78"
                            android:background="@drawable/bg_progress_fill_teal" />

                        <View
                            android:id="@+id/barGalleEmpty"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.22" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 3 Metric Cards Row: 2.8h / 1.6d / +12% -->
            <LinearLayout
                android:id="@+id/metricsCardsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Card 1: 2.8h Median response -->
                <LinearLayout
                    android:id="@+id/cardMedianResponse"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_metric"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical|start"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/textMedianResponseValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="2.8h"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Median response"
                        android:textColor="#8A9BA8"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Card 2: 1.6d Time to resolve -->
                <LinearLayout
                    android:id="@+id/cardTimeToResolve"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_metric"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical|start"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/textTimeToResolveValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="1.6d"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Time to resolve"
                        android:textColor="#8A9BA8"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Card 3: +12% vs last month (Mint Tinted) -->
                <LinearLayout
                    android:id="@+id/cardMonthlyGrowth"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_metric_mint"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical|start"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/textMonthlyGrowthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="+12%"
                        android:textColor="#2A9D8F"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="vs last month"
                        android:textColor="#4A8B7C"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 4: GEOGRAPHIC HEAT MAP -->
            <LinearLayout
                android:id="@+id/cardGeographicHeatMapOuter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_analytics_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/headingGeographicHeatMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="GEOGRAPHIC HEAT MAP"
                    android:textColor="#8A9BA8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textRegionCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Sri Lanka"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <!-- Inner Heat Map Container with Target Nodes Graphic -->
                <FrameLayout
                    android:id="@+id/cardGeographicHeatMap"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_heat_map_inner_box">

                    <!-- Sleek Target Nodes matching reference image: ⌖ • ◎ • ⌖ -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Left crosshair target icon -->
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Target location"
                            android:src="@drawable/ic_gps_target"
                            app:tint="#64748B" />

                        <!-- Small connector dot -->
                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_circle_black"
                            android:backgroundTint="#64748B" />

                        <!-- Center satellite target node -->
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Center hotspot"
                            android:src="@drawable/ic_satellite_target" />

                        <!-- Small connector dot -->
                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_circle_black"
                            android:backgroundTint="#64748B" />

                        <!-- Right crosshair target icon -->
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Target location"
                            android:src="@drawable/ic_gps_target"
                            app:tint="#64748B" />
                    </LinearLayout>

                    <!-- Functional WebView retained for background Leaflet map support -->
                    <WebView
                        android:id="@+id/webHeatMap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.0"
                        android:overScrollMode="never"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar on screen -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/fragment_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp" />

</LinearLayout>
