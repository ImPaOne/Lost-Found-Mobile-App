<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    tools:context=".SplashActivity">

    <!-- Center Branding Container -->
    <LinearLayout
        android:id="@+id/centerBrandingBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.46">

        <!-- Logo Container without background shapes -->
        <FrameLayout
            android:id="@+id/logoOuterBox"
            android:layout_width="120dp"
            android:layout_height="120dp">

            <ImageView
                android:id="@+id/logoIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="App Logo"
                android:src="@drawable/logoo"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- App Name: Foundly in black -->
        <TextView
            android:id="@+id/appNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:text="Foundly"
            android:textColor="#FF000000"
            android:textSize="40sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- Accent Divider -->
        <View
            android:id="@+id/brandDivider"
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="#FF000000" />

        <!-- Tagline: black text -->
        <TextView
            android:id="@+id/taglineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="Lost less. Found faster."
            android:textColor="#FF333333"
            android:textSize="15sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
