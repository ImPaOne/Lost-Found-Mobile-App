<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF003049"
    tools:context=".SplashActivity">

    <!-- Center Branding Container -->
    <LinearLayout
        android:id="@+id/centerBrandingBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.46">

        <!-- Logo Card: white rounded card with brand logo -->
        <FrameLayout
            android:id="@+id/logoOuterBox"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_splash_outer_card"
            android:elevation="8dp"
            android:padding="16dp">

            <ImageView
                android:id="@+id/logoIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="App Logo"
                android:src="@drawable/ic_splash_logo"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- App Name: Foundly — large, bold, white on deep blue -->
        <TextView
            android:id="@+id/appNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:text="Foundly"
            android:textColor="#FFFFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- Accent Divider: Brick Red -->
        <View
            android:id="@+id/brandDivider"
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_splash_divider" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/taglineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="Lost less. Found faster."
            android:textColor="#AACBDF"
            android:textSize="15sp" />

        <!-- Loading dots -->
        <LinearLayout
            android:id="@+id/indicatorDotsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dotFirst"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot_active" />

            <View
                android:id="@+id/dotSecond"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dot_inactive_1" />

            <View
                android:id="@+id/dotThird"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dot_inactive_2" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
