<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flyerRootLayout"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:background="#003049"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- Status Banner: LOST or FOUND -->
    <LinearLayout
        android:id="@+id/flyerStatusBanner"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#C1121F"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvFlyerStatusAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="⚠ LOST ITEM"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Item Image: full width -->
    <ImageView
        android:id="@+id/imgFlyerPhoto"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_item_placeholder" />

    <!-- Content Area: white card on deep blue -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFAF0E6"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Brand + Category row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_splash_logo"
                app:tint="#C1121F" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="FOUNDLY"
                android:textColor="#003049"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFlyerCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_banner"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:fontFamily="sans-serif-bold"
                android:text="GENERAL"
                android:textColor="#C1121F"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Item Title -->
        <TextView
            android:id="@+id/tvFlyerItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:text="Item Name"
            android:textColor="#003049"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Location -->
        <TextView
            android:id="@+id/tvFlyerLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="📍 Colombo, Sri Lanka"
            android:textColor="#5B8DB8"
            android:textSize="13sp" />

        <!-- Description (short) -->
        <TextView
            android:id="@+id/tvFlyerDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:text="Scan QR to view and contact the reporter."
            android:textColor="#5C4638"
            android:textSize="12sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#DDCFC2" />

        <!-- QR + Reporter row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- QR Code -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="110dp"
                android:layout_height="110dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:strokeColor="#DDCFC2"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imgFlyerQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Scan instructions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="SCAN QR TO REPORT"
                    android:textColor="#003049"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFlyerDirectLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="foundly://item/id"
                    android:textColor="#8C7E74"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvFlyerReporterTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Reported on Foundly"
                    android:textColor="#B0A39B"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
