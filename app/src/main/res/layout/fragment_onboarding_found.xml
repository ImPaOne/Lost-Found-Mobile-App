<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF6FF"
    tools:context=".OnboardingFoundFragment">

    <!-- 1. Top Concentric Circular Illustration Area -->
    <FrameLayout
        android:id="@+id/boxIllustrationArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cardBottomSheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Outer Ring -->
        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_onboard_outer_circle">

            <!-- Middle Ring -->
            <FrameLayout
                android:layout_width="196dp"
                android:layout_height="196dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_onboard_inner_circle">

                <!-- Center Squircle with Navy Background and Bag Icon -->
                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_onboard_squircle"
                    android:elevation="6dp">

                    <ImageView
                        android:id="@+id/iconBag"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:contentDescription="Found Bag Icon"
                        android:src="@drawable/ic_onboard_bag" />
                </FrameLayout>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- 2. Bottom Sheet Container (White card with rounded top corners) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_rounded"
        android:elevation="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Drag Handle Pill -->
        <View
            android:id="@+id/handlePill"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_sheet_drag_handle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Top Right "Skip" Pill Button -->
        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_btn_skip_pill"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:text="Skip"
            android:textColor="#475569"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/handlePill" />

        <!-- Main Title (Left aligned) -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans-serif-bold"
            android:text="Found Something?"
            android:textColor="#0B2032"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnSkip" />

        <!-- Subtitle Description (Left aligned) -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4dp"
            android:text="Share a secure found-item report and help its owner identify it safely."
            android:textColor="#64748B"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

        <!-- 3-Dot Page Indicator (Left aligned): 1st inactive, 2nd active, 3rd inactive -->
        <LinearLayout
            android:id="@+id/dotsIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDescription">

            <View
                android:id="@+id/dotInactive1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_onboard_dot_inactive" />

            <View
                android:id="@+id/dotActive"
                android:layout_width="22dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_onboard_dot_active" />

            <View
                android:id="@+id/dotInactive2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_onboard_dot_inactive" />
        </LinearLayout>

        <!-- Primary Action "Next" Button -->
        <TextView
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_btn_onboard"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="Next"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dotsIndicator" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
