<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".DetailsFragment">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 1. Header: Circular Back Arrow, "Report Details" title, Circular More Options (...) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:id="@+id/boxBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_icon_button"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Back"
                        android:focusable="true"
                        android:src="@drawable/ic_arrow_back_stem"
                        app:tint="#0F172A" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Report Details"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Hidden share view for full backward compatibility -->
                <ImageView
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Circular Top Bookmark / Save Button -->
                <FrameLayout
                    android:id="@+id/boxBookmark"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_circle_icon_button"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/boxOptions"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/btnBookmark"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Save item"
                        android:focusable="true"
                        android:src="@drawable/ic_bookmark_outline"
                        app:tint="#0F172A" />
                </FrameLayout>

                <!-- Circular Three Dots (...) Menu -->
                <FrameLayout
                    android:id="@+id/boxOptions"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_icon_button"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/btnMoreOptions"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="More options"
                        android:focusable="true"
                        android:src="@drawable/ic_more_dots"
                        app:tint="#0F172A" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 2. Main Hero Photo Card (Full visible photo, no bottom overlay clipping) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPhotoContainer"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:id="@+id/boxPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#0A0E1A">

                    <!-- Default / Fallback Photo -->
                    <ImageView
                        android:id="@+id/imgPhotoDefault"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Item image"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_item_placeholder" />

                    <!-- Dynamic Carousel ViewPager2 -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/pagerPhotos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Tap to enlarge hint badge (Modern pill in bottom-right corner) -->
                    <LinearLayout
                        android:id="@+id/badgeEnlargeHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_photo_counter_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Zoom"
                            android:src="@drawable/ic_pinch_frame"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Tap to expand"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Photo dots indicator (for multi-image) -->
                    <LinearLayout
                        android:id="@+id/photoDotsIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <View
                            android:id="@+id/dotPhoto1"
                            android:layout_width="18dp"
                            android:layout_height="4.5dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_photo_dot_active" />

                        <View
                            android:id="@+id/dotPhoto2"
                            android:layout_width="6dp"
                            android:layout_height="4.5dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_photo_dot_inactive" />

                        <View
                            android:id="@+id/dotPhoto3"
                            android:layout_width="6dp"
                            android:layout_height="4.5dp"
                            android:background="@drawable/bg_photo_dot_inactive" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2b. Item Title & Status Badge Row (Directly below photo, never cut off) -->
            <LinearLayout
                android:id="@+id/rowItemTitleStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvItemTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:paddingBottom="2dp"
                    android:text="Black leather wallet"
                    android:textColor="#0F172A"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tagStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_badge_matched_pill"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="RESOLVED"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Card 1: REPORT PROGRESS (Matching Reference Image) -->
            <LinearLayout
                android:id="@+id/cardReportProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card_report_item"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/lblProgressTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="REPORT PROGRESS"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- 4-Step Timeline Dots and Lines -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- Step 1: Reported -->
                    <View
                        android:id="@+id/dotStep1"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_dot_progress_completed" />

                    <!-- Line 1 to 2 -->
                    <View
                        android:id="@+id/lineStep1to2"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_weight="1"
                        android:background="#002840" />

                    <!-- Step 2: Under Review -->
                    <View
                        android:id="@+id/dotStep2"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_dot_progress_completed" />

                    <!-- Line 2 to 3 -->
                    <View
                        android:id="@+id/lineStep2to3"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_weight="1"
                        android:background="#002840" />

                    <!-- Step 3: Matched (Active ring dot) -->
                    <View
                        android:id="@+id/dotStep3"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_dot_progress_active" />

                    <!-- Line 3 to 4 -->
                    <View
                        android:id="@+id/lineStep3to4"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_weight="1"
                        android:background="#E2E8F0" />

                    <!-- Step 4: Resolved -->
                    <View
                        android:id="@+id/dotStep4"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_dot_progress_inactive" />
                </LinearLayout>

                <!-- 4-Step Labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lblStep1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="Reported"
                        android:textColor="#002840"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/lblStep2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="Under Review"
                        android:textColor="#002840"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/lblStep3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Matched"
                        android:textColor="#002840"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lblStep4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="Resolved"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. Card 2: ITEM DETAILS (Matching Reference Image) -->
            <LinearLayout
                android:id="@+id/cardItemDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card_report_item"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="ITEM DETAILS"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Item Description -->
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="Men's black leather wallet with NIC, bank cards and approximately LKR 4,500."
                    android:textColor="#334155"
                    android:textSize="13.5sp" />

                <!-- Location Pin and String -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="Location pin"
                        android:src="@drawable/ic_location"
                        app:tint="#64748B" />

                    <TextView
                        android:id="@+id/tvLocationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif"
                        android:text="Liberty Plaza, Colombo 03 · 12 Sep 2026"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Small Interactive Leaflet Map Preview below Item Details -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardItemMapContainer"
                    android:layout_width="match_parent"
                    android:layout_height="175dp"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="visible"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <WebView
                            android:id="@+id/webViewItemMap"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Transparent overlay ensuring whole card tap opens MapFragment -->
                        <View
                            android:id="@+id/mapClickOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- Top-Right Fullscreen / Open Map Badge -->
                        <LinearLayout
                            android:id="@+id/badgeOpenMapPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_photo_counter_pill"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Open Map ↗"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Bottom Coordinates & Tap Hint Badge Overlay -->
                        <LinearLayout
                            android:id="@+id/boxMapCoordinatesBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_photo_counter_pill"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="Location pin"
                                android:src="@drawable/ic_location"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:id="@+id/tvMapCoordinates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="6.0367° N, 80.2170° E · Tap for full map"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 5. Card 3: MATCHING SUGGESTIONS (Matching Reference Image) -->
            <LinearLayout
                android:id="@+id/cardMatchingSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card_report_item"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="MATCHING SUGGESTIONS"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Dynamic match badge -->
                    <TextView
                        android:id="@+id/tvMatchScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_match_percent"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="10dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="2dp"
                        android:text="Scanning..."
                        android:textColor="#0D9488"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMatchTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Checking matching suggestions..."
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMatchSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif"
                    android:text="Scanning community lost &amp; found reports"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 6. Action Buttons: [ Edit ] and [ Mark Resolved ] (Matching Reference Image) -->
            <LinearLayout
                android:id="@+id/rowOwnerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_edit_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="Edit"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMarkResolved"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary_navy"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="Mark Resolved"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 7. Full-width [ Delete report ] button (Matching Reference Image) -->
            <TextView
                android:id="@+id/btnDeleteReport"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_btn_delete_report"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="Delete report"
                android:textColor="#DC2626"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 8. Preserved Visitor / Non-Owner Actions (Hidden when owner, visible when visitor) -->
            <LinearLayout
                android:id="@+id/sectionVisitorActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Reporter Profile Card -->
                <LinearLayout
                    android:id="@+id/rowReporter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_reporter_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_avatar_circle_border">

                        <ImageView
                            android:id="@+id/imgAvatar"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Reporter avatar"
                            android:src="@drawable/ic_person"
                            app:tint="#64748B" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvReporterName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Tharindu Perera"
                            android:textColor="#0F172A"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvReporterTrust"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="Trust score 94"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Contact Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLiveChat"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#002840"
                    android:fontFamily="sans-serif-bold"
                    android:text="Contact Reporter"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWhatsApp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#25D366"
                    android:fontFamily="sans-serif-bold"
                    android:text="WhatsApp Reporter"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <!-- Preserved legacy views for complete zero-breakage code compatibility -->
            <LinearLayout
                android:id="@+id/bannerLocation"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone">
                <TextView android:id="@+id/tvStreetName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/btnOpenFullMap" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>



            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSimilarItem"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone">
                <ImageView android:id="@+id/imgSimilar" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvSimilarTag" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvSimilarTime" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvSimilarTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvSimilarLocation" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/lblSimilar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnSeeAllSimilar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 9. Persistent Bottom Navigation Bar (Consistent across all screens) -->
    <include
        android:id="@+id/bottomNavBox"
        layout="@layout/fragment_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp" />

</LinearLayout>
