<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".DetailsFragment">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Header: Back Arrow, "Item details" title, Bookmark icon -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:clickable="true"
                    android:contentDescription="Back"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_back_chevron"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Item details"
                    android:textColor="#3D2619"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/btnBookmark"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:clickable="true"
                    android:contentDescription="Bookmark item"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_bookmark_outline"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 2. Main Photo Banner with Slideable ViewPager2 and Dot Indicators -->
            <FrameLayout
                android:id="@+id/boxPhoto"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#1E1612">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/pagerPhotos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Tap to enlarge hint badge -->
                <LinearLayout
                    android:id="@+id/badgeEnlargeHint"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_card_badge"
                    android:backgroundTint="#80000000"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="⤢ Tap to enlarge"
                        android:textColor="@color/white"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Carousel Dots Indicator Overlay -->
                <LinearLayout
                    android:id="@+id/photoDotsIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dotPhoto1"
                        android:layout_width="18dp"
                        android:layout_height="4.5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_onboard_dot_active" />

                    <View
                        android:id="@+id/dotPhoto2"
                        android:layout_width="5dp"
                        android:layout_height="4.5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_onboard_dot_inactive" />

                    <View
                        android:id="@+id/dotPhoto3"
                        android:layout_width="5dp"
                        android:layout_height="4.5dp"
                        android:background="@drawable/bg_onboard_dot_inactive" />
                </LinearLayout>
            </FrameLayout>

            <!-- 3. Details Content Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- Outlined LOST Status Tag -->
                <TextView
                    android:id="@+id/tagStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_lost_outlined"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="12dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="3dp"
                    android:text="LOST"
                    android:textColor="#E54B4B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Item Title -->
                <TextView
                    android:id="@+id/tvItemTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Black leather wallet"
                    android:textColor="#3D2619"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Item Description -->
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="Slim wallet with national ID and two bank cards. Small scratch near the clasp."
                    android:textColor="#7D6F67"
                    android:textSize="14sp" />

                <!-- Metadata Row: Location & Timestamp -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="Location icon"
                        android:src="@drawable/ic_location_compass" />

                    <TextView
                        android:id="@+id/tvLocationText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="Colombo 03"
                        android:textColor="#7D6F67"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTimestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="12 Sep · 6:30 PM"
                        android:textColor="#7D6F67"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Location Banner: Near Duplication Road -->
                <LinearLayout
                    android:id="@+id/bannerLocation"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_location_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/tvStreetName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Near Duplication Road"
                        android:textColor="#5C4638"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Pin"
                        android:src="@drawable/ic_location"
                        app:tint="#5C4638" />
                </LinearLayout>

                <!-- Reporter Profile Row -->
                <LinearLayout
                    android:id="@+id/rowReporter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Avatar -->
                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="Reporter avatar"
                        android:src="@drawable/ic_user_avatar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvReporterName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Tharindu Perera"
                                android:textColor="#3D2619"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="4dp"
                                android:contentDescription="Verified"
                                android:src="@drawable/ic_verified_check" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvReporterTrust"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="sans-serif"
                            android:text="Verified · Trust score 94"
                            android:textColor="#7D6F67"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Primary Action Button: Contact Reporter -->
                <TextView
                    android:id="@+id/btnContact"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn_contact"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Contact Reporter"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <!-- 4. Section: Similar items -->
                <TextView
                    android:id="@+id/lblSimilar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Similar items"
                    android:textColor="#3D2619"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Similar Item Card: Brown card holder -->
                <LinearLayout
                    android:id="@+id/cardSimilarItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Thumbnail -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/imgSimilar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Brown card holder"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_brown_card_holder" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvSimilarTag"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-bold"
                                android:text="FOUND"
                                android:textColor="#5C4638"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSimilarTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="2h ago"
                                android:textColor="#7D6F67"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSimilarTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Brown card holder"
                            android:textColor="#3D2619"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="Pin"
                                android:src="@drawable/ic_location"
                                app:tint="#7D6F67" />

                            <TextView
                                android:id="@+id/tvSimilarLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:fontFamily="sans-serif"
                                android:text="Kollupitiya"
                                android:textColor="#7D6F67"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 5. Persistent Bottom Navigation Bar -->
    <include
        android:id="@+id/bottomNavBox"
        layout="@layout/fragment_bottom_nav" />

</LinearLayout>
