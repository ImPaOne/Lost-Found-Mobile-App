<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardReport"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_settings_card"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Title, Selection Checkbox & Status Badge -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <CheckBox
            android:id="@+id/cbSelectReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#002B3D"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textReportTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="2"
            android:text="Report Title"
            android:textColor="@color/text_primary"
            android:textSize="16.5sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/badgeReportStatus"
            app:layout_constraintStart_toEndOf="@+id/cbSelectReport"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/badgeReportStatus"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_badge_flagged"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Flagged"
            android:textColor="@color/badge_flagged_text"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Subtitle: Author · Location · Category -->
    <TextView
        android:id="@+id/textReportAuthorLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:text="Author · Location"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Description Snippet (optional) -->
    <TextView
        android:id="@+id/textReportDescriptionSnippet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#64748B"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <!-- Warning Alert Note (Visible when flagged or has note) -->
    <LinearLayout
        android:id="@+id/bannerReportWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_warning_banner"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="Alert Flag"
            android:src="@drawable/ic_flag_alert"
            app:tint="@color/badge_flagged_text" />

        <TextView
            android:id="@+id/textReportWarningNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="Sensitive content reported"
            android:textColor="@color/badge_flagged_text"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Action Buttons Row: Approve, Reject, Escalate -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/buttonReportApprove"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_approve"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Approve"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonReportReject"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_reject"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Reject"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonReportEscalate"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_escalate"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Options"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
