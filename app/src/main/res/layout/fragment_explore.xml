<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ExploreFragment">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">
            <!-- 1. Top Header: Close button, "Explore" title, Map icon -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Close / Dismiss button -->
                <FrameLayout
                    android:id="@+id/btnClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_close_btn"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Close"
                        android:src="@drawable/ic_close_circle_white" />
                </FrameLayout>

                <!-- Explore Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Explore"
                    android:textColor="#3D2E27"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Folded Map Icon -->
                <ImageView
                    android:id="@+id/btnMapView"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:contentDescription="Map View"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_map_folded"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <!-- 2. Search Bar: Cylinder icon, Hint text, Filter sliders -->
            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_search_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/iconSearch"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_search_cylinder" />

                <EditText
                    android:id="@+id/inputSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="sans-serif"
                    android:hint="Search by item or location"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="#3A2D28"
                    android:textColorHint="#A48374"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnFilter"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:clickable="true"
                    android:contentDescription="Filters"
                    android:focusable="true"
                    android:src="@drawable/ic_filter" />
            </LinearLayout>
            <!-- 3. Category Filter Chips (All, Lost, Found, Pets) -->
            <LinearLayout
                android:id="@+id/chipsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="All"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipLost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="Lost"
                    android:textColor="#3A2D28"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipFound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="Found"
                    android:textColor="#3A2D28"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipPets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:text="Pets"
                    android:textColor="#3A2D28"
                    android:textSize="13sp" />
            </LinearLayout>
            <!-- 4. Results subtitle + View Mode Icons (Grid & List) -->
            <LinearLayout
                android:id="@+id/resultsHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvResultsCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="64 results near Colombo"
                    android:textColor="#7D6F67"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/btnGridView"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:contentDescription="Grid view"
                    android:focusable="true"
                    android:src="@drawable/ic_grid_view" />

                <ImageView
                    android:id="@+id/btnListView"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:clickable="true"
                    android:contentDescription="List view"
                    android:focusable="true"
                    android:src="@drawable/ic_list_view" />
            </LinearLayout>
            <!-- 5. Items Grid: 2 Columns -->
            <!-- ROW 1: Blue Samsung phone & Sri Lankan passport -->
            <LinearLayout
                android:id="@+id/rowItems1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Left Card: Blue Samsung phone -->
                <LinearLayout
                    android:id="@+id/cardPhone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/imgPhone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Blue Samsung phone"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_samsung_phone" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvPhoneStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="LOST · 2h"
                        android:textColor="#D43838"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPhoneTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Blue Samsung\nphone"
                        android:textColor="#3A2D28"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:contentDescription="Location pin"
                            android:src="@drawable/ic_location_compass" />

                        <TextView
                            android:id="@+id/tvPhoneLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif"
                            android:text="Bambalapitiya"
                            android:textColor="#7D6F67"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right Card: Sri Lankan passport -->
                <LinearLayout
                    android:id="@+id/cardPassport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/imgPassport"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Sri Lankan passport"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_passport" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvPassportStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="FOUND · 2h"
                        android:textColor="#3D2E27"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPassportTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Sri Lankan passport"
                        android:textColor="#3A2D28"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:contentDescription="Location pin"
                            android:src="@drawable/ic_location_compass" />

                        <TextView
                            android:id="@+id/tvPassportLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif"
                            android:text="Fort Railway Station"
                            android:textColor="#7D6F67"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 2: Brown tabby cat & AirPods Pro case -->
            <LinearLayout
                android:id="@+id/rowItems2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Left Card: Brown tabby cat -->
                <LinearLayout
                    android:id="@+id/cardCat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/imgCat"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Brown tabby cat"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_tabby_cat" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvCatStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="LOST · 2h"
                        android:textColor="#D43838"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvCatTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Brown tabby cat"
                        android:textColor="#3A2D28"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:contentDescription="Location pin"
                            android:src="@drawable/ic_location_compass" />

                        <TextView
                            android:id="@+id/tvCatLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif"
                            android:text="Nugegoda"
                            android:textColor="#7D6F67"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right Card: AirPods Pro case -->
                <LinearLayout
                    android:id="@+id/cardAirpods"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/imgAirpods"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="AirPods Pro case"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_airpods_bench" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvAirpodsStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="FOUND · 2h"
                        android:textColor="#3D2E27"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvAirpodsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="AirPods Pro case"
                        android:textColor="#3A2D28"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:contentDescription="Location pin"
                            android:src="@drawable/ic_location_compass" />

                        <TextView
                            android:id="@+id/tvAirpodsLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif"
                            android:text="Galle Face"
                            android:textColor="#7D6F67"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 6. Persistent Bottom Navigation Bar -->
    <include
        android:id="@+id/bottomNavBox"
        layout="@layout/fragment_bottom_nav" />

</LinearLayout>