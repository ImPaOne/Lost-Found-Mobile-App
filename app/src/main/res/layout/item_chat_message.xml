<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="3dp"
    android:paddingEnd="16dp"
    android:paddingBottom="3dp">

    <!-- Date Divider with Lines -->
    <LinearLayout
        android:id="@+id/layoutDateHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#E2E8F0" />

        <TextView
            android:id="@+id/tvDateHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:text="TODAY · 13 SEP"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#E2E8F0" />
    </LinearLayout>

    <!-- Outgoing Message Bubble (Right aligned, deep navy) -->
    <LinearLayout
        android:id="@+id/layoutOutgoingMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/cardOutgoingBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_outgoing_bubble"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <!-- Quoted reply banner -->
            <LinearLayout
                android:id="@+id/layoutOutgoingReplyBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="#0A3D59"
                android:orientation="horizontal"
                android:padding="6dp"
                android:visibility="gone">

                <View
                    android:layout_width="3.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/accent_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOutgoingReplyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOutgoingReplyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#CBD5E1"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Attached photo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOutgoingImage"
                android:layout_width="220dp"
                android:layout_height="150dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgOutgoingPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Photo message"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Text Content -->
            <TextView
                android:id="@+id/tvOutgoingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/white"
                android:textSize="13.5sp" />

            <!-- Outgoing Timestamp & Read Status -->
            <TextView
                android:id="@+id/tvOutgoingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="3dp"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Incoming Message Bubble (Left aligned with circular avatar on bottom left) -->
    <LinearLayout
        android:id="@+id/layoutIncomingMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:gravity="bottom"
        android:maxWidth="300dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- User profile avatar at bottom left -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="2dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imgIncomingAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="User Avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_user_avatar" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/cardIncomingBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_incoming_bubble"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <!-- Quoted reply banner -->
            <LinearLayout
                android:id="@+id/layoutIncomingReplyBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="#F1F5F9"
                android:orientation="horizontal"
                android:padding="6dp"
                android:visibility="gone">

                <View
                    android:layout_width="3.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/deep_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvIncomingReplyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/deep_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvIncomingReplyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Attached photo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIncomingImage"
                android:layout_width="220dp"
                android:layout_height="150dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgIncomingPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Incoming photo"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Text Content -->
            <TextView
                android:id="@+id/tvIncomingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="#0F172A"
                android:textSize="13.5sp" />

            <!-- Incoming Timestamp -->
            <TextView
                android:id="@+id/tvIncomingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="3dp"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
