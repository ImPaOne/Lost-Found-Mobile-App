<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".CreateReportFragment">
    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">
            <!-- 1. Header: Back Arrow, "Create report" title -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:clickable="true"
                    android:contentDescription="Back"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_back_chevron"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Create report"
                    android:textColor="#3D2619"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
                        <!-- 2. Step Progress Bar: 5 horizontal segments -->
            <LinearLayout
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/segStep1"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_progress_active" />

                <View
                    android:id="@+id/segStep2"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_progress_active" />
                                    <View
                    android:id="@+id/segStep3"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_progress_inactive" />

                <View
                    android:id="@+id/segStep4"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_progress_inactive" />

                <View
                    android:id="@+id/segStep5"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_progress_inactive" />
            </LinearLayout>
            <!-- 3. Step Headings -->
            <TextView
                android:id="@+id/tvStepNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:text="STEP 2 OF 5"
                android:textColor="#624E43"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="Category &amp; details"
                android:textColor="#3D2619"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvStepSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:text="Tell the community what to look for."
                android:textColor="#7D6F67"
                android:textSize="14sp" />
            <!-- 4. Toggle Selector Cards (Lost item / Found item) -->
            <LinearLayout
                android:id="@+id/rowItemType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <!-- Lost item Card (Selected by default) -->
                <LinearLayout
                    android:id="@+id/cardLostItem"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_select_lost"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/iconLost"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Lost icon"
                        android:src="@drawable/ic_search_cylinder"
                        app:tint="#E54B4B" />

                    <TextView
                        android:id="@+id/tvLostLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Lost item"
                        android:textColor="#3D2619"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- Found item Card (Unselected by default) -->
                <LinearLayout
                    android:id="@+id/cardFoundItem"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_select_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/iconFound"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Found icon"
                        android:src="@drawable/ic_report_hand_heart" />

                    <TextView
                        android:id="@+id/tvFoundLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Found item"
                        android:textColor="#3D2619"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <!-- 5. Form Field 1: Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-bold"
                android:text="Category"
                android:textColor="#3D2619"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/boxCategory"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/tvCategoryValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="sans-serif"
                    android:text="Electronics"
                    android:textColor="#3D2619"
                    android:textSize="14sp" />
            </FrameLayout>
            <!-- 6. Form Field 2: Item title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Item title"
                android:textColor="#3D2619"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputTitle"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:hint="e.g. Blue Samsung Galaxy S24"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#3D2619"
                android:textColorHint="#A48374"
                android:textSize="14sp" />
            <!-- 7. Form Field 3: Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Description"
                android:textColor="#3D2619"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputDescription"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:hint="Colour, marks, contents and identifiers"
                android:inputType="textMultiLine"
                android:lineSpacingExtra="3dp"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:textColor="#3D2619"
                android:textColorHint="#A48374"
                android:textSize="14sp" />
            <!-- 8. "Next up" Info Banner -->
            <LinearLayout
                android:id="@+id/bannerNextUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_next_up_banner"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Next up"
                    android:textColor="#5C4638"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="3 Location picker · 4 Photos upload · 5 Review &amp; submit"
                    android:textColor="#7D6F67"
                    android:textSize="12sp" />
            </LinearLayout>
            <!-- 9. Bottom Buttons: Back & Continue -->
            <LinearLayout
                android:id="@+id/rowActionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnBackBottom"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="Back"
                    android:textColor="#3D2619"
                    android:textSize="15sp"
                    android:textStyle="bold" />