<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mapRootBox"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F4EF">

    <!-- 1. City Road Map Background Graphic -->
    <ImageView
        android:id="@+id/imgMapBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/cardLaptopItem"
        android:contentDescription="Map Area"
        android:scaleType="centerCrop"
        android:src="@drawable/img_map_bg" />

    <!-- 2. Map Marker Pins -->
    <!-- Pin 1: Top-Left Red -->
    <FrameLayout
        android:id="@+id/pinTopLeft"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="72dp"
        android:layout_marginTop="200dp"
        android:background="@drawable/bg_pin_red"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="Pin location"
            android:src="@drawable/ic_pin_white" />
    </FrameLayout>

    <!-- Pin 2: Center Red (Active / Selected) -->
    <FrameLayout
        android:id="@+id/pinCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="320dp"
        android:background="@drawable/bg_pin_red"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="Pin location"
            android:src="@drawable/ic_pin_white" />
    </FrameLayout>

    <!-- Pin 3: Top-Right Brown -->
    <FrameLayout
        android:id="@+id/pinTopRight"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="250dp"
        android:layout_marginEnd="68dp"
        android:background="@drawable/bg_pin_brown"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="Pin location"
            android:src="@drawable/ic_pin_white" />
    </FrameLayout>

    <!-- Pin 4: Bottom-Right Brown -->
    <FrameLayout
        android:id="@+id/pinBottomRight"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="360dp"
        android:layout_marginEnd="38dp"
        android:background="@drawable/bg_pin_brown"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="Pin location"
            android:src="@drawable/ic_pin_white" />
    </FrameLayout>

    <!-- 3. Floating GPS Target Button (FAB) -->
    <FrameLayout
        android:id="@+id/btnGpsTarget"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_above="@+id/cardLaptopItem"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_fab_white"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="GPS Target"
            android:src="@drawable/ic_gps_target"
            app:tint="#5C4638" />
    </FrameLayout>

    <!-- 4. Top Overlay Controls: Header, Search, Chips -->
    <LinearLayout
        android:id="@+id/topControlsBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <!-- Header: Close squircle, "Map" title, List icon -->
        <RelativeLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <FrameLayout
                android:id="@+id/btnClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_close_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Close"
                    android:src="@drawable/ic_close_white" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-bold"
                android:text="Map"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnListView"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="List view"
                android:focusable="true"
                android:src="@drawable/ic_list_view" />
        </RelativeLayout>

        <!-- Search Bar: Cylinder icon, Hint, Filter icon -->
        <LinearLayout
            android:id="@+id/searchBarBox"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_search_box"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/iconCylinder"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search Icon"
                android:src="@drawable/ic_search_cylinder" />

            <EditText
                android:id="@+id/inputSearchArea"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:hint="Search this area"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="#998B82"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnFilterSliders"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:clickable="true"
                android:contentDescription="Filter items"
                android:focusable="true"
                android:src="@drawable/ic_filter" />
        </LinearLayout>

        <!-- Filter Chips Row: Lost, Found, Today -->
        <LinearLayout
            android:id="@+id/chipRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipLost"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_lost"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Lost"
                android:textColor="#DE4343"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipFound"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip_found"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Found"
                android:textColor="#5C4638"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipToday"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip_today"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Today"
                android:textColor="#5C4638"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. Floating Item Preview Card (Red laptop sleeve) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLaptopItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottomNav"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Red Laptop Sleeve Thumbnail -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="74dp"
                android:layout_height="74dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imgLaptopThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Red laptop sleeve"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_laptop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Item Information -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tagFoundStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="sans-serif-bold"
                        android:text="FOUND"
                        android:textColor="#5C4638"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textItemTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="sans-serif"
                        android:text="12m"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/textItemTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Red laptop sleeve"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="Location"
                        android:src="@drawable/ic_location"
                        app:tint="#8E7E75" />

                    <TextView
                        android:id="@+id/textItemLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif"
                        android:text="Independence Square"
                        android:textColor="#7C6E66"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 6. Bottom Navigation Bar on screen -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/fragment_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
