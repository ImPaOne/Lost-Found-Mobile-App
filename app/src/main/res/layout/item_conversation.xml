<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#F1F5F9"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Item / User Photo Thumbnail -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="54dp"
            android:layout_height="54dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imgConversationThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Thumbnail"
                android:scaleType="centerCrop"
                android:src="@drawable/img_wallet" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Conversation Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Row 1: User Name & Timestamp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvConversationUserName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:text="Kasun Jayasinghe"
                    android:textColor="@color/text_primary"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConversationTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="09:41"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Row 2: Item Name & Optional Resolved Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRelatedItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:text="Black leather wallet"
                    android:textColor="#C1121F"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badgeResolved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tag_resolved_pill"
                    android:paddingStart="6dp"
                    android:paddingTop="1.5dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1.5dp"
                    android:text="Resolved"
                    android:textColor="#0D9488"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Row 3: Last Message Preview & Unread / Read Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLastMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:text="Could you describe a detail that isn't in the report?"
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <!-- Unread Badge Count (Dark navy circle with number) -->
                <TextView
                    android:id="@+id/tvUnreadBadge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_badge_unread_count"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <!-- Sent / Read Double Checkmark -->
                <ImageView
                    android:id="@+id/imgReadReceipt"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Read status"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="#0D9488" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
