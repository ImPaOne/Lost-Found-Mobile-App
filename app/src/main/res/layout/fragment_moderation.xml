<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ModerationFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/moderationScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background_screen"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Top Header Bar: Back Chevron, Title "Moderation", Search Icon -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/buttonBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon_button"
                android:clickable="true"
                android:contentDescription="Go back"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_back_chevron"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Moderation"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/buttonSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon_button"
                android:clickable="true"
                android:contentDescription="Search reports"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Segmented Tab Container (Pending Review, Flagged, Approved) -->
        <LinearLayout
            android:id="@+id/segmentedTabsContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_segment_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <!-- Tab 1: Pending Review (Active) -->
            <TextView
                android:id="@+id/tabPendingReview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:background="@drawable/bg_segment_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Pending Review"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Tab 2: Flagged -->
            <TextView
                android:id="@+id/tabFlagged"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Flagged"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Tab 3: Approved -->
            <TextView
                android:id="@+id/tabApproved"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.95"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Approved"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Action Row: Select all & Approve selected -->
        <LinearLayout
            android:id="@+id/actionRowLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonSelectAll"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Select all"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/buttonApproveSelected"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_btn_approve"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Approve selected"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Reports Count Subtitle -->
        <TextView
            android:id="@+id/textReportsCountSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="• 24 reports awaiting review"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/pbLoadingModeration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:indeterminate="true"
            android:indeterminateTint="#0B2238"
            android:visibility="visible" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layoutEmptyModeration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="36dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:alpha="0.4"
                android:contentDescription="No reports"
                android:src="@drawable/ic_search" />

            <TextView
                android:id="@+id/textEmptyModerationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-bold"
                android:text="No reports in this category"
                android:textColor="#0B1B2B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textEmptyModerationSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="All community reports in this category are up to date."
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Dynamic Moderation Reports RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvModerationReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar on screen -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/fragment_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp" />

</LinearLayout>
