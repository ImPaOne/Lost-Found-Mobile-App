<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_screen"
    android:orientation="vertical"
    tools:context=".LoginFragment">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Decorative Header with Pastel Bubbles & Centered Brand Squircle -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="175dp">

                <!-- Pastel Mint Bubble Left -->
                <View
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="-30dp"
                    android:layout_marginTop="-20dp"
                    android:background="@drawable/bg_soft_bubble_mint" />

                <!-- Pastel Mint Bubble Center/Top -->
                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_soft_bubble_mint" />

                <!-- Pastel Mint Bubble Right -->
                <View
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginEnd="-35dp"
                    android:layout_marginTop="55dp"
                    android:background="@drawable/bg_soft_bubble_mint" />

                <!-- Centered Logo Card & Brand Name -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="38dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_login_logo_card"
                        android:elevation="3dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:adjustViewBounds="true"
                            android:contentDescription="Foundly App Logo"
                            android:scaleType="fitCenter"
                            android:src="@drawable/logoo" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Foundly"
                        android:textColor="#0B283A"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </RelativeLayout>

            <!-- Form Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <!-- Main Heading & Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Welcome back"
                    android:textColor="#0B283A"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Sign in to continue finding what matters."
                    android:textColor="#718292"
                    android:textSize="14sp" />

                <!-- Email or phone Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Email or phone"
                    android:textColor="#0B283A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Email Input Field -->
                <EditText
                    android:id="@+id/inputEmail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_search_box"
                    android:fontFamily="sans-serif"
                    android:hint="nadeesha@email.com"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#0B283A"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp" />

                <!-- Password Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Password"
                    android:textColor="#0B283A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Password Input Field with Eye Icon -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_search_box">

                    <EditText
                        android:id="@+id/inputPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@+id/btnTogglePassword"
                        android:background="@null"
                        android:fontFamily="sans-serif"
                        android:hint="••••••••"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:textColor="#0B283A"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="14dp"
                        android:clickable="true"
                        android:contentDescription="Toggle password visibility"
                        android:focusable="true"
                        android:src="@drawable/ic_eye"
                        app:tint="#718292" />
                </RelativeLayout>

                <!-- Options Row: Remember Me & Forgot Password -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <CheckBox
                        android:id="@+id/checkRememberMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:buttonTint="#94A3B8"
                        android:fontFamily="sans-serif"
                        android:text="Remember me"
                        android:textColor="#718292"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-bold"
                        android:text="Forgot Password?"
                        android:textColor="#0B283A"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Login Action Button -->
                <TextView
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_btn_login_navy"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="Login"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Footer: Don't have an account? Sign Up -->
                <LinearLayout
                    android:id="@+id/rowSignUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Don't have an account? "
                        android:textColor="#718292"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Sign Up"
                        android:textColor="#0D9488"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
