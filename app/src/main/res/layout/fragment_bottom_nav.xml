<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navCard"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="@color/white"
    android:baselineAligned="false"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- 1. Home Tab -->
    <LinearLayout
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgHome"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Home icon"
            android:src="@drawable/ic_nav_home" />

        <TextView
            android:id="@+id/lblHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="Home"
            android:textColor="@color/see_all_color"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 2. Explore Tab -->
    <LinearLayout
        android:id="@+id/tabExplore"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgExplore"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Explore icon"
            android:src="@drawable/ic_nav_explore" />

        <TextView
            android:id="@+id/lblExplore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="Explore"
            android:textColor="@color/see_all_color"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 3. My reports Tab (Matching exact 4-tab bar in details screen) -->
    <LinearLayout
        android:id="@+id/tabReports"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgReports"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="My reports icon"
            android:src="@drawable/ic_nav_my_reports" />

        <TextView
            android:id="@+id/lblReports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="My reports"
            android:textColor="@color/see_all_color"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 4. Profile Tab -->
    <LinearLayout
        android:id="@+id/tabProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Profile icon"
            android:src="@drawable/ic_nav_profile" />

        <TextView
            android:id="@+id/lblProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="Profile"
            android:textColor="@color/see_all_color"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
