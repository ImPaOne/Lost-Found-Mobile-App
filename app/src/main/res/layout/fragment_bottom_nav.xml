<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navCard"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/white"
    android:baselineAligned="false"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- 1. Home Tab -->
    <LinearLayout
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgHome"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Home"
            android:src="@drawable/ic_nav_home" />

        <TextView
            android:id="@+id/lblHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="Home"
            android:textColor="@color/see_all_color"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 2. Explore Tab -->
    <LinearLayout
        android:id="@+id/tabExplore"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgExplore"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Explore"
            android:src="@drawable/ic_nav_explore" />

        <TextView
            android:id="@+id/lblExplore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="Explore"
            android:textColor="@color/see_all_color"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 3. Center + Post Pill Button -->
    <LinearLayout
        android:id="@+id/tabPost"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/btnPostPill"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_nav_post_pill"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Post"
                android:src="@drawable/ic_nav_add_circle" />

            <TextView
                android:id="@+id/lblPost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="+ Post"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Messages Tab -->
    <LinearLayout
        android:id="@+id/tabMessages"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgMessages"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Messages"
            android:src="@drawable/ic_nav_messages" />

        <TextView
            android:id="@+id/lblMessages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="Messages"
            android:textColor="@color/see_all_color"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 5. Profile Tab -->
    <LinearLayout
        android:id="@+id/tabProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Profile"
            android:src="@drawable/ic_nav_profile" />

        <TextView
            android:id="@+id/lblProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="Profile"
            android:textColor="@color/see_all_color"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
