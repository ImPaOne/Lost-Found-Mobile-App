<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavigationCard"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/white"
    android:baselineAligned="false"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- 1. Home Tab -->
    <LinearLayout
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageHomeIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Home icon"
            android:src="@drawable/ic_nav_home" />

        <TextView
            android:id="@+id/textHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-bold"
            android:text="Home"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Explore Tab -->
    <LinearLayout
        android:id="@+id/tabExplore"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageExploreIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Explore icon"
            android:src="@drawable/ic_nav_explore" />

        <TextView
            android:id="@+id/textExploreLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="Explore"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 3. Post Tab (Center prominent rounded pill button) -->
    <LinearLayout
        android:id="@+id/tabPost"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/buttonPostPill"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_stat_banner"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imagePostIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Create Post icon"
                android:src="@drawable/ic_nav_add_circle" />

            <TextView
                android:id="@+id/textPostLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-bold"
                android:text="+ Post"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Messages Tab -->
    <LinearLayout
        android:id="@+id/tabMessages"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageMessagesIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Messages icon"
                android:src="@drawable/ic_nav_messages" />

            <!-- Red notification unread badge -->
            <View
                android:id="@+id/badgeMessagesDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_red_dot" />
        </FrameLayout>

        <TextView
            android:id="@+id/textMessagesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="Messages"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 5. Profile Tab -->
    <LinearLayout
        android:id="@+id/tabProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageProfileIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Profile icon"
            android:src="@drawable/ic_nav_profile" />

        <TextView
            android:id="@+id/textProfileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="Profile"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
