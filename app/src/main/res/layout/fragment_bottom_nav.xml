<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navCard"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_bottom_nav_bar"
    android:baselineAligned="false"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- 1. Home Tab -->
    <LinearLayout
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/boxHome"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgHome"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Home"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/text_hint" />
        </FrameLayout>

        <TextView
            android:id="@+id/lblHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Home"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 2. Explore Tab -->
    <LinearLayout
        android:id="@+id/tabExplore"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/boxExplore"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgExplore"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Explore"
                android:src="@drawable/ic_nav_explore"
                app:tint="@color/text_hint" />
        </FrameLayout>

        <TextView
            android:id="@+id/lblExplore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Explore"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 3. My Reports Tab (Matching reference image) -->
    <LinearLayout
        android:id="@+id/tabReports"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/boxReports"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgReports"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="My reports"
                android:src="@drawable/ic_nav_my_reports"
                app:tint="@color/text_hint" />
        </FrameLayout>

        <TextView
            android:id="@+id/lblReports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="My reports"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 4. Center Post Button (Used for Admin or post flow) -->
    <LinearLayout
        android:id="@+id/tabPost"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/btnPostPill"
            android:layout_width="54dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_nav_post_pill"
            android:elevation="2dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Post"
                android:src="@drawable/ic_plus"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-bold"
                android:text="+ Post"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. Messages Tab (Used for Admin Users tab or messages) -->
    <LinearLayout
        android:id="@+id/tabMessages"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/boxMessages"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgMessages"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Messages"
                android:src="@drawable/ic_nav_messages"
                app:tint="@color/text_hint" />
        </FrameLayout>

        <TextView
            android:id="@+id/lblMessages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Messages"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 6. Profile Tab -->
    <LinearLayout
        android:id="@+id/tabProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/boxProfile"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Profile"
                android:src="@drawable/ic_nav_profile"
                app:tint="@color/text_hint" />
        </FrameLayout>

        <TextView
            android:id="@+id/lblProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Profile"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
