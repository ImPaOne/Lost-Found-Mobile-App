<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — Fiery Ocean palette -->
    <style name="Base.Theme.LostAndFound" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">#FF003049</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">#FFFAF0E6</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <!-- Soft input mode: content scrolls above keyboard -->
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Theme.LostAndFound" parent="Base.Theme.LostAndFound" />

    <!-- Rounded image corners -->
    <style name="ShapeAppearance.RoundedSquare" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- Circular profile avatars -->
    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>