<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LostAndFound" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Status bar styling to match clean white warm theme -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.LostAndFound" parent="Base.Theme.LostAndFound" />

    <!-- Style for rounded corner item preview images (18dp corner radius) -->
    <style name="ShapeAppearance.RoundedSquare" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- Circular shape for profile avatars -->
    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>