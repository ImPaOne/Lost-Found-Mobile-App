<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LostAndFound" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Status bar styling to match clean light screen -->
        <item name="android:statusBarColor">@color/background_screen</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.LostAndFound" parent="Base.Theme.LostAndFound" />

    <!-- Style for rounded corner item preview images -->
    <style name="ShapeAppearance.RoundedSquare" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
</resources>