<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: recreates the provided logo with
    two sky-blue rounded swoosh strokes (forming an F-like lettermark)
    plus a solid royal-blue circle dot at the bottom-right.
    White background is supplied by ic_launcher_background.xml.
    Viewport is 108x108 (standard adaptive icon safe zone = 72x72 centred).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Upper large swoosh (top-right → curves down-left) ───────────── -->
    <!-- Rendered as a thick rounded stroke path -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#29B6F6"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M67,18 C67,18 67,18 67,18 C67,14 64,12 60,12 C56,12 44,12 36,12 C32,12 30,14 30,18 C30,22 30,30 30,36 C30,42 34,46 40,46" />

    <!-- ── Lower smaller swoosh (middle → curves down toward dot) ─────── -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4FC3F7"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M40,46 C40,46 40,46 40,46 C46,46 68,46 72,46 C76,46 78,49 78,53 C78,57 78,62 78,66 C78,70 76,73 72,74" />

    <!-- ── Royal-blue circle dot at bottom-right ─────────────────────── -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M72,74 m-10,0 a10,10 0,1 1,20 0 a10,10 0,1 1,-20 0" />

</vector>