<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_splash_logo.xml
    Recreates the provided brand logo: two sky-blue rounded swoosh strokes
    (forming an F-like lettermark) and a royal-blue filled circle dot.
    Intended to be placed over a white background on the splash screen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="80dp"
    android:height="96dp"
    android:viewportWidth="80"
    android:viewportHeight="96">

    <!-- ── Upper large swoosh ─────────────────────────────────────────── -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#29B6F6"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M62,10 C62,10 62,10 62,10 C62,6 59,4 55,4 C50,4 36,4 28,4 C23,4 20,7 20,12 C20,17 20,26 20,33 C20,40 25,44 32,44" />

    <!-- ── Lower smaller swoosh ───────────────────────────────────────── -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4FC3F7"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M32,44 C32,44 32,44 32,44 C40,44 60,44 65,44 C70,44 73,47 73,52 C73,57 73,63 73,68 C73,72 70,75 66,76" />

    <!-- ── Royal-blue circle dot ─────────────────────────────────────── -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M56,76 m0,0 a11,11 0,1 1,22 0 a11,11 0,1 1,-22 0" />

</vector>
